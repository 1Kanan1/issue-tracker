# Copy to .env and fill in. .env is gitignored; never commit it.

# Signs JWTs. Must be at least 32 bytes or the app refuses to start.
# Generate with: openssl rand -base64 48
SECRET_KEY=""

DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/issue_tracker"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Seeded on startup if the user does not already exist.
# Leaving ADMIN_PASSWORD empty skips seeding entirely.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@example.com"